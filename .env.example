# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
PORT=8080
GIN_MODE=release
LOG_LEVEL=info

MONGO_URI=mongodb://<user>:<password>@<host>:27017/?authSource=admin&directConnection=true
MONGO_DATABASE=global360

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_ISSUER=global360
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=168h

BCRYPT_COST=12
MAX_FAILED_LOGIN_ATTEMPTS=5

# Bootstrap superadmin, created on startup only if the email does not exist yet.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
